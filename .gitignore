# Campaign state is written exclusively via GitHub API — not tracked locally.
# Committing it locally would conflict with API writes from other machines.
campaign-state.json
pat.txt

# Claude Code local tooling (worktrees, etc.) — not project content.
# Exception: .claude/skills/ is committed project tooling (e.g. run-<app>
# skills), so it's carved back out below.
.claude/*
!.claude/skills/
.claude/skills/*/screenshots/
.claude/skills/*/__pycache__/

# Monster token images — generated by tools/fetch-monster-tokens.py, not tracked in git.
shared/img/monsters/
